{
  "name": "marshell",
  "version": "1.1.5",
  "description": "Open-source cross-platform workspace for project terminals, live preview, process monitoring, and task tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BhagirathsinhRana378/marshell.git"
  },
  "homepage": "https://marshell.bond",
  "bugs": {
    "url": "https://github.com/BhagirathsinhRana378/marshell/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3010",
    "build": "next build",
    "start": "next start",
    "tauri": "tauri",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "rimraf dist out .next .turbo src-tauri/target && turbo run clean",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "turbo test",
    "shadcn": "pnpm --filter @workspace/ui shadcn",
    "deps:check": "taze -r",
    "deps:update": "taze -r -w -i -I",
    "setup:notifications": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/setup-dev-notifications.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@workspace/core": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.174.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.174.0",
    "@workspace/typescript-config": "workspace:*",
    "rimraf": "^6.1.3",
    "taze": "^19.14.1",
    "tsx": "^4.23.15",
    "turbo": "^2.9.18",
    "typescript": "~5.9.3",
    "ultracite": "7.8.3"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "engines": {
    "node": ">=20"
  }
}
